---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro demo</title>
  </head>
  <body>
    <nav>
      <a href={`${base}/`}>Inicio</a>
      <a href={`${base}/acerca`}>Acerca</a>
      <a href={`${base}/hora`}>Hora</a>
    </nav>
    <slot />
  </body>
</html>
