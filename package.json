{
  "name": "todo2todo",
  "version": "0.1.0",
  "description": "Convierte proyectos web JS en apps de escritorio (Electron) y móviles (Capacitor)",
  "type": "module",
  "bin": {
    "todo2todo": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
